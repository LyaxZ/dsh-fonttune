{
  "name": "dsh-fonttune",
  "version": "0.2.5",
  "description": "Font plugin for the DeepSeek Harness Web GUI: the conversation gets its own font, size, line height and weight, the interface font and weight follow it, code keeps its own axis with ligature control, and whole setups save as presets.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "CHANGELOG.en.md",
    "LICENSE"
  ],
  "engines": {
    "dsh": ">=0.1.5-rc.1 <0.1.7-0 || >=0.1.7-alpha.1 <0.2.0-0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    },
    "compatibility": {
      "dshReleases": {
        "0.1.5-rc.1": "compatible",
        "0.1.5-rc.2": "compatible",
        "0.1.5-rc.3": "compatible",
        "0.1.7-alpha.1": "compatible",
        "0.1.7-alpha.2": "compatible"
      }
    }
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": "^3.18.0",
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "test": "node test/run.mjs && node test/render-card.mjs",
    "verify": "node test/run.mjs && node test/render-card.mjs && node test/artifacts.mjs",
    "verify:browser": "node test/browser-verify.mjs",
    "prepublishOnly": "node build.mjs && node test/run.mjs && node test/render-card.mjs && node test/artifacts.mjs"
  },
  "license": "MIT",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "font",
    "font-family",
    "font-size",
    "font-weight",
    "typography"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LyaxZ/dsh-fonttune.git"
  }
}
